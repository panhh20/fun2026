# Databricks Configuration
# When deployed in Databricks, these environment variables are automatically available
# For local development, copy this file to .env and fill in your values

# Your Databricks workspace URL (automatically set as DATABRICKS_HOST in Databricks)
DATABRICKS_HOST=https://xxx.cloud.databricks.com

# Your Databricks personal access token (automatically available in Databricks)
DATABRICKS_TOKEN=dapi...

# Name of your model serving endpoint
DATABRICKS_SERVING_ENDPOINT=your-endpoint-name
